{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LiveTrans",
  "version": "0.2.0",
  "identifier": "io.github.misterrabbit0w0.livetrans",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "beforeBundleCommand": "python ../scripts/check_bundled_core.py"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://localhost:5173"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "resources/livetrans-core": "livetrans-core"
    }
  }
}

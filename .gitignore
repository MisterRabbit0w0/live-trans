# Python
__pycache__/
*.py[cod]
*.egg-info/
*.egg
build/
dist/
.eggs/

# 虚拟环境
.venv/
.venv-build/
venv/
env/

# 测试产物（脚本运行时生成的录音）
scripts/*.wav

# 本地配置与日志（含 API Key，位于 %APPDATA%，此处兜底）
config.json
*.log
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12
*.dmp
gitleaks-report.*

# 模型缓存
.cache/

# IDE / 编辑器
.idea/
.vscode/
*.swp
.DS_Store

# 桌面快捷方式
*.lnk

# Tauri 桌面端（desktop/）
desktop/node_modules/
desktop/src-tauri/target/
desktop/src-tauri/gen/
# 随包核心由 build_windows.py 复制到此，仅保留占位 .gitkeep 供编译期检查
desktop/src-tauri/resources/livetrans-core/*
!desktop/src-tauri/resources/livetrans-core/.gitkeep
